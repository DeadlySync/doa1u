# Evaluate source selection without configuring a toolchain or compiling.
# Usage from port root: cmake -DDOA1U_DIAGNOSTIC=ON -P tools/check_source_config.cmake
cmake_minimum_required(VERSION 3.20)
function(project)
    set(PROJECT_NAME doa1u_recomp PARENT_SCOPE)
endfunction()
function(add_compile_definitions)
endfunction()
function(add_subdirectory)
endfunction()
function(enable_language)
endfunction()
function(target_sources)
endfunction()
function(add_library)
endfunction()
function(target_link_libraries)
endfunction()
function(target_compile_definitions)
endfunction()
function(target_include_directories)
endfunction()
function(target_compile_options)
endfunction()
function(target_link_options)
endfunction()
function(add_executable target)
    if(NOT target STREQUAL "doa1u_recomp")
        return()
    endif()
    set(sources ${ARGN})
    list(REMOVE_ITEM sources WIN32)
    set(diagnostics 0)
    set(adapters 0)
    foreach(source IN LISTS sources)
        if(IS_ABSOLUTE "${source}")
            set(source_path "${source}")
        else()
            set(source_path "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
        endif()
        if(NOT EXISTS "${source_path}")
            message(FATAL_ERROR "Missing target source: ${source}")
        endif()
        if(source MATCHES "^src/diagnostics/")
            math(EXPR diagnostics "${diagnostics} + 1")
        elseif(source STREQUAL "src/runtime/diagnostics_disabled.c")
            math(EXPR adapters "${adapters} + 1")
        endif()
    endforeach()
    if(DOA1U_DIAGNOSTIC)
        if(NOT diagnostics EQUAL 2 OR NOT adapters EQUAL 0)
            message(FATAL_ERROR "Incorrect diagnostic source selection")
        endif()
    elseif(NOT diagnostics EQUAL 0 OR NOT adapters EQUAL 1)
        message(FATAL_ERROR "Release includes diagnostics or lacks runtime adapters")
    endif()
    list(LENGTH sources count)
    message(STATUS "Validated ${count} target sources; diagnostic=${DOA1U_DIAGNOSTIC}; probes=${diagnostics}; adapters=${adapters}")
endfunction()

# CONFIGURE_DEPENDS cannot run in script mode, so emulate only the generated glob.
function(file mode)
    if(mode STREQUAL "GLOB")
        _file(GLOB generated "${CMAKE_CURRENT_SOURCE_DIR}/src/recomp/gen/*.c")
        set(RECOMP_GEN_SOURCES "${generated}" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unexpected file operation during source validation: ${mode}")
    endif()
endfunction()
