# Replace only the file implementation, after upstream has created xbox_kernel.
# Keep upstream headers, target options, bridge, path layer and every other source.
function(doa1u_select_xbox_file_backend target runtime_root)
    if(NOT TARGET "${target}" OR NOT TARGET doa1u_xiso_reader)
        message(FATAL_ERROR "DOA1U file backend requires xbox_kernel and doa1u_xiso_reader targets")
    endif()
    get_target_property(source_dir "${target}" SOURCE_DIR)
    get_target_property(sources "${target}" SOURCES)
    get_filename_component(expected "${runtime_root}/src/kernel/kernel_file.c" ABSOLUTE)
    get_filename_component(replacement "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/filesystem/xbox_file.c" ABSOLUTE)
    set(selected)
    set(matches 0)
    foreach(source IN LISTS sources)
        if(source MATCHES "\\$<")
            message(FATAL_ERROR "DOA1U file backend cannot audit generator-expression kernel sources: ${source}")
        endif()
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${source_dir}")
        get_filename_component(name "${absolute}" NAME)
        if(absolute STREQUAL replacement)
            message(FATAL_ERROR "DOA1U file backend was already selected: ${replacement}")
        elseif(name STREQUAL "kernel_file.c")
            if(NOT absolute STREQUAL expected)
                message(FATAL_ERROR "Unexpected kernel_file.c source: ${absolute}; expected ${expected}")
            endif()
            math(EXPR matches "${matches} + 1")
            list(APPEND selected "${replacement}")
        else()
            list(APPEND selected "${source}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "DOA1U file backend requires exactly one kernel_file.c source; found ${matches}")
    endif()
    if(NOT EXISTS "${replacement}")
        message(FATAL_ERROR "Missing project-owned Xbox file implementation: ${replacement}")
    endif()
    set_property(TARGET "${target}" PROPERTY SOURCES "${selected}")
    target_include_directories("${target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/filesystem")
    target_link_libraries("${target}" PRIVATE doa1u_xiso_reader)
    set_property(TARGET "${target}" PROPERTY DOA1U_FILE_BACKEND_SOURCE "${replacement}")
    message(STATUS "xbox_kernel: exactly one DOA1U file backend selected (${replacement})")
endfunction()

function(doa1u_add_xbox_file_backend_check)
    add_executable(disc_bootstrap_check EXCLUDE_FROM_ALL
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/disc_bootstrap_check.cpp")
    target_include_directories(disc_bootstrap_check PRIVATE
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/filesystem")
    target_link_libraries(disc_bootstrap_check PRIVATE xbox_kernel shell32)
    if(MSVC)
        target_compile_options(disc_bootstrap_check PRIVATE /W4 /WX /EHsc)
    endif()
    add_executable(xbox_file_backend_check EXCLUDE_FROM_ALL
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/xbox_file_backend_check.c")
    target_include_directories(xbox_file_backend_check PRIVATE
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/filesystem")
    target_link_libraries(xbox_file_backend_check PRIVATE xbox_kernel doa1u_xiso_reader shell32)
    add_executable(xbox_image_file_check EXCLUDE_FROM_ALL
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/xbox_image_file_check.cpp")
    target_include_directories(xbox_image_file_check PRIVATE
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/filesystem")
    target_link_libraries(xbox_image_file_check PRIVATE xbox_kernel doa1u_xiso_reader shell32)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(bridge "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/xboxrecomp/src/kernel/kernel_bridge.c")
    set(bridge_generator "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/check_xiso_bridge.py")
    set(bridge_fixture "${CMAKE_CURRENT_BINARY_DIR}/xiso-bridge-check/xiso_bridge_bodies.h")
    add_custom_command(OUTPUT "${bridge_fixture}"
        COMMAND "${Python3_EXECUTABLE}" "${bridge_generator}" "${bridge}" "${bridge_fixture}"
        DEPENDS "${bridge}" "${bridge_generator}" VERBATIM)
    target_sources(xbox_image_file_check PRIVATE "${bridge_fixture}")
    target_include_directories(xbox_image_file_check PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/xiso-bridge-check")
    if(MSVC)
        target_compile_options(xbox_image_file_check PRIVATE /W4 /WX /EHsc)
    endif()
endfunction()
